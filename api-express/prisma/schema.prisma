generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  pseudo         String?   @unique
  password       String
  themes         String[]  @default([])
  picture        String?
  color          String?
  isPublic       Boolean   @default(false)
  isAdmin        Boolean   @default(false)
  firstName      String?
  lastName       String?
  partyName      String?
  isCandidate    Boolean   @default(false)
  lastLoginAt    DateTime?
  ogPicName      String?
  isLoadTest     Boolean   @default(false)
  // "ios" / "android" (native app) or "web-mobile" / "web-desktop" / "web-tablet", see utils/visit-source.ts. Null before Oct 2026.
  platform       String?
  // Set by hand from the donation e-mail (controllers/chat.ts): raises the AI chat limits until that date.
  supporterUntil DateTime?

  // Relations
  answers   Answer[]
  chats     Chat[]
  ideas     Idea[]
  ideaVotes IdeaVote[]
  friends   User[]     @relation("UserFriends")
  friendOf  User[]     @relation("UserFriends")
}

model Answer {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  themeId     String
  questionId  String
  answerIndex Int
  isImportant Boolean  @default(false)

  // Relations
  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@index([userId])
}

// One conversation with the AI. messages holds the whole history ({ role, content }[]), written by the API only:
// clients send the new user message, never the history, so they cannot put words in the assistant's mouth.
model Chat {
  id           String    @id @default(uuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  // "president" | "convaincre" | "contre-moi-meme"
  mode         String
  // candidate id from candidates-answers.json, "convaincre" mode only
  candidateId  String?
  messages     Json      @default("[]")
  model        String
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  costEur      Float     @default(0)
  // Deleted by the user: messages are emptied, the row stays so tokens, cost and daily limits still count.
  deletedAt    DateTime?

  // Relations
  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@index([userId])
}

// Money in and out, entered by the admin on /soutenir (or when validating a Tipeee donation).
// The AI cost is not here: it is summed live from Chat.costEur.
model LedgerEntry {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  date      DateTime
  // "donation" | "expense"
  kind      String
  amountEur Float
  // Shown publicly for expenses only: donations appear as a total, never by donor.
  label     String
  // "tipeee-claim:<userId>:<claim date>" for a validated donation, so validating the same claim twice records it once.
  source    String?  @unique
}

// Ideas board on /soutenir: what the donations should fund next.
model Idea {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  title       String
  description String   @default("")
  // "pending" (waits for the admin, only its author sees it) | "open" | "planned" | "in-progress" | "done" | "rejected"
  status      String   @default("pending")

  // Relations
  author   User       @relation(fields: [authorId], references: [id])
  authorId String
  votes    IdeaVote[]

  @@index([status])
}

model IdeaVote {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Relations
  idea   Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  ideaId String
  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@unique([ideaId, userId])
}

// One row per page seen by a human visitor, sent by the site's own tracking script (no cookie).
// visitorId is a hash of IP + user-agent salted with the day: it counts unique visitors per day and
// cannot follow anyone from one day to the next.
model PageView {
  id          BigInt   @id @default(autoincrement())
  createdAt   DateTime @default(now())
  path        String
  isEntry     Boolean  @default(false)
  // Normalized origin of the visit ("Google", "Instagram", "hardware.fr"…), null = direct.
  // Repeated on every page of the visit, so pages can be filtered by source.
  source      String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  device      String
  visitorId   String

  @@index([createdAt])
}

// One row per page request from a known crawler (Googlebot, ChatGPT-User, GPTBot…), sent in batches by app-tanstack/server.mjs.
model BotHit {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now())
  bot       String
  // "ai-answer" | "indexing" | "training" | "preview" | "other"
  category  String
  path      String
  status    Int

  @@index([createdAt])
}
